# Keep the app image small and secret-free.
node_modules
.next
out
build

# Secrets / local env — NEVER copy into the image.
.env
.env.*
!.env.example
!.env.production.example

# VCS / tooling
.git
.gitignore
.github
.vscode
.idea

# Local private storage (mounted as a volume at runtime).
storage

# NOTE: renderer/ is intentionally NOT ignored — the renderer image builds from
# the repo-root context (renderer/Dockerfile COPY renderer/...). It is small
# (Python only) and harmless to include in the app context as well.

# Logs / OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Эталоны и тесты в образ не попадают и на сборку не влияют, но раньше ехали в
# контекст: любая их правка инвалидировала `COPY . .`, а с ним `prisma generate`
# и `next build`. Эталон клиентского текста перегенерируется почти при каждом
# изменении отчёта, поэтому это била по каждой пересборке.
baselines
tests
