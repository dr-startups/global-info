# ============================================================================
# Global Info — environment template
# Copy to `.env` and fill in. NEVER commit a real .env or real secrets.
# All defaults below are safe for local development.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/global_info?schema=public"

# ----------------------------------------------------------------------------
# Digital Profile Audit module — master switch
# ----------------------------------------------------------------------------
# The entire module (routes/UI/services) stays disabled unless "true".
DIGITAL_PROFILE_ENABLED="false"

# Mock mode: agents must not call external APIs (deterministic demo data).
# Real safe agents (Wikipedia) still run regardless via their own flags.
DIGITAL_PROFILE_MOCK_AGENTS="true"

# ----------------------------------------------------------------------------
# Storage + signed downloads (evidence and reports are PRIVATE) — Stage M2
# ----------------------------------------------------------------------------
# Storage driver. Only "local" is implemented; "s3"/"r2"/"supabase" are reserved
# for future drivers (the app fails fast if selected without an implementation).
DIGITAL_PROFILE_STORAGE_DRIVER="local"

# Private storage root for screenshots and generated reports (never public).
# DIGITAL_PROFILE_STORAGE_ROOT is canonical; DIGITAL_PROFILE_STORAGE_DIR is the
# back-compat alias (both point at the same directory).
DIGITAL_PROFILE_STORAGE_ROOT="./storage/digital-profile"
DIGITAL_PROFILE_STORAGE_DIR="./storage/digital-profile"

# Optional public base URL for a CDN/bucket (unused by the local driver).
# DIGITAL_PROFILE_STORAGE_PUBLIC_BASE_URL=""

# Secret for signing private download tokens. Canonical name:
# DIGITAL_PROFILE_SIGNED_URL_SECRET (DIGITAL_PROFILE_SIGNING_SECRET is an alias).
DIGITAL_PROFILE_SIGNED_URL_SECRET="change-me-in-production"

# Signed download URL TTL (seconds). DIGITAL_PROFILE_STORAGE_SIGNED_URL_TTL_SECONDS
# is canonical; DIGITAL_PROFILE_SIGNED_URL_TTL is the back-compat alias. This one
# value governs ALL private download links.
DIGITAL_PROFILE_STORAGE_SIGNED_URL_TTL_SECONDS="900"

# ----------------------------------------------------------------------------
# Report renderer microservice (PPTX/PDF). See renderer/ + docker-compose.yml.
# ----------------------------------------------------------------------------
# Canonical name: RENDERER_URL.
# (DIGITAL_PROFILE_RENDERER_URL is accepted as an alias.)
RENDERER_URL="http://localhost:8080"

# Default currency for report pricing config.
DIGITAL_PROFILE_PRICE_CURRENCY="EUR"

# Server-side fallback template when a render request omits templateVersion:
# "report-template-v3" (polished + commercial block), "report-template-v2"
# (full 36-page audit), "report-template-v1" (corporate) or "simple".
# Render requests also accept audience (internal|client) and watermarkMode
# (draft|none) — these only affect template v3.
DIGITAL_PROFILE_REPORT_TEMPLATE_VERSION="report-template-v3"

# Default Admin UI language ("ru" | "en"). UI-only: does not affect the API,
# database, agents or the rendered report. If unset or invalid, falls back to
# "ru". Users can switch language in the UI (persisted in localStorage).
DIGITAL_PROFILE_DEFAULT_LOCALE="ru"

# ----------------------------------------------------------------------------
# ORION-style SERP snapshot generator (Stage S1)
# ----------------------------------------------------------------------------
# Synthetic, key-free image built ONLY from already-stored search_results
# (no live capture, no Playwright, no scraping). Safe to keep enabled.
DIGITAL_PROFILE_SERP_SNAPSHOT_ENABLED="true"
DIGITAL_PROFILE_SERP_SNAPSHOT_FORMAT="png"
DIGITAL_PROFILE_SERP_SNAPSHOT_WIDTH="1600"
DIGITAL_PROFILE_SERP_SNAPSHOT_HEIGHT="950"
DIGITAL_PROFILE_SERP_SNAPSHOT_MAX_RESULTS_PER_ENGINE="7"
DIGITAL_PROFILE_SERP_SNAPSHOT_MAX_THEMES="5"
# Result classifications (and risk themes) highlighted with a red frame.
DIGITAL_PROFILE_SERP_SNAPSHOT_HIGHLIGHT_CLASSIFICATIONS="ADVERSE_MEDIA,SANCTIONS,PEP,NEGATIVE,HIGH_RISK"

# ----------------------------------------------------------------------------
# Auth + roles + access control (Stage M1)
# ----------------------------------------------------------------------------
# Master auth switch. Default "false" keeps the local demo + smoke flow working
# WITHOUT login (every actor is treated as a synthetic SUPER_ADMIN). Set "true"
# to require login, enforce roles and per-case access.
#
# PRODUCTION: set this to "true" AND set a strong DIGITAL_PROFILE_SESSION_SECRET
# (>=16 chars). With auth enabled in production the app fails to start on the
# default/empty secret (fail-closed).
DIGITAL_PROFILE_AUTH_ENABLED="false"

# HMAC secret used to sign the stateless session cookie. Generate a random value
# for any non-local environment, e.g.:  openssl rand -base64 32
DIGITAL_PROFILE_SESSION_SECRET="change-me-in-production"

# Demo admin credentials, used ONLY by `npm run db:seed`. DEMO-ONLY — change or
# remove for any real deployment. Seed also creates analyst/reviewer/client demo
# users with fixed demo passwords (see docs/digital-profile/SECURITY.md).
DIGITAL_PROFILE_DEMO_ADMIN_EMAIL="superadmin@demo.local"
DIGITAL_PROFILE_DEMO_ADMIN_PASSWORD="demo-Admin-12345"

# ----------------------------------------------------------------------------
# Commercial offer block (prices/text come from config, never hardcoded in
# slides). All optional — sensible defaults are used when unset.
# ----------------------------------------------------------------------------
# DIGITAL_PROFILE_PRODUCT_NAME="Digital Profile Audit"
# DIGITAL_PROFILE_SOLUTION1_TITLE="Digital Profile Audit — Basic"
# DIGITAL_PROFILE_SOLUTION2_TITLE="Digital Profile Audit — Standard"
# DIGITAL_PROFILE_SOLUTION3_TITLE="Digital Profile Audit — Enterprise"
# DIGITAL_PROFILE_PRICING_NOTES="Prices are indicative and exclude taxes."
# DIGITAL_PROFILE_COMPANY_NAME="Digital Profile Audit"
# DIGITAL_PROFILE_CONTACT_EMAIL="contact@example.com"
# DIGITAL_PROFILE_WEBSITE="https://example.com"
# DIGITAL_PROFILE_BRAND_NAME="Digital Profile Audit"
# DIGITAL_PROFILE_REPORT_SUBTITLE="Digital footprint & compliance audit"
# DIGITAL_PROFILE_COMPANY_DESCRIPTION="Evidence-first digital profile & compliance audits."
# DIGITAL_PROFILE_CTA="Contact our team to scope an engagement."

# ----------------------------------------------------------------------------
# Real connectors (Stage H). Only official/public APIs — no scraping, no
# leaked datasets, no SERP screenshots.
# ----------------------------------------------------------------------------
# Master switch for keyed SERP providers (Google/Yandex). Does NOT gate Wikipedia.
DIGITAL_PROFILE_REAL_CONNECTORS_ENABLED="false"

# Wikipedia is a public, official, free API and has its own independent flag:
DIGITAL_PROFILE_WIKIPEDIA_ENABLED="true"
DIGITAL_PROFILE_WIKIPEDIA_LANGS="ru,en"
# DIGITAL_PROFILE_WIKIPEDIA_USER_AGENT="GlobalInfo-DigitalProfile/1.0 (contact: you@example.com)"
# DIGITAL_PROFILE_WIKIPEDIA_MIN_INTERVAL_MS="250"

# Keyed SERP providers (each requires the master switch + its own flag + keys):
DIGITAL_PROFILE_GOOGLE_ENABLED="false"
DIGITAL_PROFILE_YANDEX_ENABLED="false"

# Keyed-provider HTTP timeout (ms) and per-run result cap.
DIGITAL_PROFILE_PROVIDER_TIMEOUT_MS="15000"
DIGITAL_PROFILE_PROVIDER_MAX_RESULTS="20"

# Provider credentials (leave empty -> provider resolves to NOT_CONFIGURED).
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
YANDEX_SEARCH_API_KEY=""
YANDEX_SEARCH_FOLDER_ID=""
YANDEX_SEARCH_REGION=""

# --- Stage N1: official Yandex Cloud Search API v2 (REAL_YANDEX_SEARCH agent) ---
# Dedicated switch, independent of the H2 master switch. Default OFF.
# Endpoint: POST https://searchapi.api.cloud.yandex.net/v2/web/search (Api-Key auth).
# Reuses YANDEX_SEARCH_API_KEY + YANDEX_SEARCH_FOLDER_ID above. Never commit real keys.
DIGITAL_PROFILE_YANDEX_REAL_ENABLED="false"
YANDEX_SEARCH_TIMEOUT_MS="15000"
YANDEX_SEARCH_MAX_QUERIES_PER_AUDIT="5"
YANDEX_SEARCH_RESULTS_PER_QUERY="10"
YANDEX_SEARCH_LOCALIZATION="ru"

# --- Stage N2: real Google search (REAL_GOOGLE_SEARCH agent) ---
# Dedicated switch, independent of the H2 master switch. Default OFF.
# NO browser scraping, NO Playwright — official APIs only.
DIGITAL_PROFILE_GOOGLE_REAL_ENABLED="false"
# Strategy: custom_search | external_serp | disabled (default disabled).
#  - custom_search: Google Programmable Search JSON API
#    (GET https://www.googleapis.com/customsearch/v1). May be unavailable to new
#    Google Cloud projects — check access before relying on it.
#  - external_serp: paid SERP API (serper implemented; serpapi/zenserp/searchapi planned).
GOOGLE_SEARCH_PROVIDER="disabled"
# Custom Search credentials (reuses GOOGLE_SEARCH_API_KEY / GOOGLE_SEARCH_ENGINE_ID
# defined above). Leave empty -> provider resolves to NOT_CONFIGURED.
GOOGLE_SEARCH_TIMEOUT_MS="15000"
GOOGLE_SEARCH_MAX_QUERIES_PER_AUDIT="3"
GOOGLE_SEARCH_RESULTS_PER_QUERY="10"
GOOGLE_SEARCH_GL="ru"
GOOGLE_SEARCH_HL="ru"
# External SERP (future-ready; enum provider NAME only — never an arbitrary URL).
# Allowed names: serpapi | serper | zenserp | searchapi.
GOOGLE_EXTERNAL_SERP_PROVIDER=""
GOOGLE_EXTERNAL_SERP_API_KEY=""
# Backward-compatible alias for Serper (falls back when GOOGLE_EXTERNAL_SERP_API_KEY is empty):
SERPER_API_KEY=""
GOOGLE_EXTERNAL_SERP_TIMEOUT_MS="15000"

# ARSENKIN TOOLS (First36 pilot: check-top, suggest, paa). Off by default.
# Token never logged or written into client report text.
ARSENKIN_ENABLED=false
ARSENKIN_API_TOKEN=""
# Optional override (default https://arsenkin.ru/api/tools)
ARSENKIN_API_BASE_URL=""
ARSENKIN_TOOLS=check-top,suggest,paa,ai-serp,check-h,indexation
ARSENKIN_MAX_CONCURRENT=3
ARSENKIN_REQUESTS_PER_MINUTE=30
# Enrich First36 live render with Arsenkin (skip if already enriched). Set 0 to disable.
ARSENKIN_ENRICH_ON_RENDER=1

# Stage O1–O4 — ORION search surfaces (multi-query matrix + Serper surfaces).
# Primary query variants per region (default 5). Risk probes off by default.
ORION_MAX_PRIMARY_QUERIES_PER_REGION="5"
ORION_INCLUDE_RISK_PROBES="false"
# Per-region Google geo/language overrides (Serper gl/hl); defaults: RU ru/ru, UAE ae/en, INT us/en.

# Stage C1 — Compliance databases (manual import always available; real API stubs only).
DIGITAL_PROFILE_COMPLIANCE_REAL_ENABLED=false

DOW_JONES_ENABLED=false
DOW_JONES_API_BASE_URL=
DOW_JONES_CLIENT_ID=
DOW_JONES_CLIENT_SECRET=
DOW_JONES_TIMEOUT_MS=20000

LEXISNEXIS_ENABLED=false
LEXISNEXIS_API_BASE_URL=
LEXISNEXIS_CLIENT_ID=
LEXISNEXIS_CLIENT_SECRET=
LEXISNEXIS_TIMEOUT_MS=20000

WORLD_CHECK_ENABLED=false
WORLD_CHECK_API_BASE_URL=
WORLD_CHECK_API_KEY=
WORLD_CHECK_API_SECRET=
WORLD_CHECK_GROUP_ID=
WORLD_CHECK_TIMEOUT_MS=20000
