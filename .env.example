# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/global_info?schema=public"

# ----------------------------------------------------------------------------
# Digital Profile Audit module
# ----------------------------------------------------------------------------
# Master feature flag. Module routes/UI/services stay disabled unless "true".
DIGITAL_PROFILE_ENABLED="false"

# Private storage root for screenshots and generated reports (never public).
DIGITAL_PROFILE_STORAGE_DIR="./storage/digital-profile"

# Signed URL secret + TTL (seconds) for evidence/report downloads.
DIGITAL_PROFILE_SIGNED_URL_SECRET="change-me-in-production"
DIGITAL_PROFILE_SIGNED_URL_TTL="600"

# Default currency for report pricing config.
DIGITAL_PROFILE_PRICE_CURRENCY="EUR"

# Report renderer microservice (PPTX/PDF). See renderer/ + docker-compose.yml.
RENDERER_URL="http://localhost:8080"

# ----------------------------------------------------------------------------
# Optional connectors (Stage H). Leave empty to keep agents in mock/manual mode.
# Only official APIs or manual import are allowed — no leaked/illegal datasets.
# ----------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
YANDEX_SEARCH_API_KEY=""
LEXISNEXIS_API_KEY=""
DOWJONES_API_KEY=""
WORLDCHECK_API_KEY=""
