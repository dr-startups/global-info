# =============================================================================
# Global Info — переменные окружения
# =============================================================================
#
# Правило: **здесь живут только секреты.**
#
# Всё остальное — включатели провайдеров, выбор источника выдачи, пределы
# частоты, адреса сервисов, настройки воркера — имеет в коде такое значение,
# при котором продукт работает целиком (`src/modules/digital-profile/config/
# defaults.ts`). Помнить набор флагов не нужно и не следует: именно забытая
# `GOOGLE_EXTERNAL_SERP_PROVIDER` однажды молча выключила ORION и Google на
# рабочем стенде.
#
# Включённые по умолчанию провайдеры ничего не открывают сами по себе:
# разрешением служит ключ. Без ключа провайдер отдаёт NOT_CONFIGURED с
# названной причиной и в сеть не ходит.
#
# Контейнер печатает на старте готовность каждого сборщика и называет
# недостающую переменную — сверять этот файл глазами не требуется.
# -----------------------------------------------------------------------------

# --- Обязательные -------------------------------------------------------------

# Postgres. На Railway — ссылка на переменную сервиса базы.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/global_info?schema=public"

# Подпись ссылок на скачивание отчётов. Случайная строка ≥ 32 знаков.
DIGITAL_PROFILE_SIGNED_URL_SECRET=""

# Сессии админки. Своя случайная строка ≥ 32 знаков.
DIGITAL_PROFILE_SESSION_SECRET=""

# --- Ключи источников ---------------------------------------------------------
# Каждый ключ включает свой источник. Отсутствующий ключ — не ошибка: отчёт
# соберётся без этой поверхности и честно назовёт, чего в нём нет.

# Arsenkin Tools: подсказки, PAA, AI-выдача, позиции, аудит URL.
ARSENKIN_API_TOKEN=""

# Serper — выдача Google и поверхности ORION.
# Псевдоним: GOOGLE_EXTERNAL_SERP_API_KEY.
SERPER_API_KEY=""

# Yandex Cloud Search API v2.
YANDEX_SEARCH_API_KEY=""
YANDEX_SEARCH_FOLDER_ID=""

# Слой текста отчёта. Без него текст останется детерминированным шаблоном.
OPENAI_API_KEY=""

# Санкционные и PEP-наборы.
OPEN_SANCTIONS_API_KEY=""

# --- Локальная разработка -----------------------------------------------------
# В проде не задавать: значения по умолчанию рассчитаны именно на прод.

# Вход в админку обязателен по умолчанию. Локально его отключают, чтобы не
# заводить пользователя.
DIGITAL_PROFILE_AUTH_ENABLED=false

# Адрес рендерера. По умолчанию — внутреннее имя сервиса на Railway, соседний
# порт локально. Задавать только при другой раскладке.
# RENDERER_URL="http://localhost:8080"

# Путь тома с артефактами. По умолчанию /data/digital-profile на Railway и
# ./storage/digital-profile локально.
# DIGITAL_PROFILE_STORAGE_ROOT=""

# Демо-агенты вместо настоящих источников: только для офлайн-проверок.
# DIGITAL_PROFILE_MOCK_AGENTS=true

# Для docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=global_info
POSTGRES_PORT=5432
APP_PORT=3000
RENDERER_PORT=8080

# --- Редкие переопределения ---------------------------------------------------
# Значения по умолчанию проверены на живых прогонах. Менять их стоит только
# осознанно и по замеру.
#
# ARSENKIN_MAX_CONCURRENT=2          одновременных обращений к Arsenkin
# ARSENKIN_REQUESTS_PER_MINUTE=24    предел аккаунта — 30 на ВСЕ вызовы вместе
# ARSENKIN_TOOLS=check-top,suggest,paa
#     По умолчанию — только первая стадия. Вторая (ai-serp, check-h,
#     indexation) отключена: в эталонном прогоне она не дала ни одного
#     наблюдения, а прогон удлиняла на отдельную волну опросов. Вернуть можно
#     здесь же, дописав недостающие инструменты:
#     ARSENKIN_TOOLS=check-top,suggest,paa,ai-serp,check-h,indexation
# ORION_MAX_PRIMARY_QUERIES_PER_REGION=5
# ORION_GPT_CONCURRENCY=2
# ORION_GPT_STAGE_DEADLINE_MS=900000
# WORKFLOW_WORKER_INLINE=false       когда воркер вынесен отдельным сервисом
# UNIFIED_COLLECTION_JOB_STORE=file  файловый режим для офлайн-смоков
