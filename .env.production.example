# ============================================================================
# Global Info — PRODUCTION environment template (Stage M3)
# Copy to `.env.production` and fill in REAL secrets. NEVER commit .env.production
# or real secrets. Values below are safe placeholders, not usable as-is.
# Used by docker-compose.prod.yml (env_file: .env.production).
# ============================================================================

NODE_ENV="production"

# Host port for the app (container always listens on 3000). Override to coexist
# with another service on 3000, e.g. a local dev server.
APP_PORT="3000"

# ----------------------------------------------------------------------------
# Postgres (the compose `postgres` service reads these too)
# ----------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME_strong_db_password"
POSTGRES_DB="global_info"

# App -> DB connection. Host is the compose service name `postgres`.
DATABASE_URL="postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/global_info?schema=public"

# ----------------------------------------------------------------------------
# Digital Profile module
# ----------------------------------------------------------------------------
DIGITAL_PROFILE_ENABLED="true"

# Production should NOT run mock agents.
DIGITAL_PROFILE_MOCK_AGENTS="false"

# Default report/UI language.
DIGITAL_PROFILE_DEFAULT_LOCALE="ru"

# ----------------------------------------------------------------------------
# Auth + roles (REQUIRED in production)
# ----------------------------------------------------------------------------
DIGITAL_PROFILE_AUTH_ENABLED="true"
# Generate a strong random value, e.g.:  openssl rand -base64 32
DIGITAL_PROFILE_SESSION_SECRET="CHANGE_ME_openssl_rand_base64_32"

# Do NOT set demo admin credentials in production. Create the first admin with:
#   docker compose -f docker-compose.prod.yml exec app npm run admin:create
# (provide ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_NAME for that command only).

# ----------------------------------------------------------------------------
# Storage + signed downloads (PRIVATE)
# ----------------------------------------------------------------------------
DIGITAL_PROFILE_STORAGE_DRIVER="local"
# Mounted volume path inside the app container (matches docker-compose.prod.yml).
DIGITAL_PROFILE_STORAGE_ROOT="/app/storage/digital-profile"

# Generate a strong random value, e.g.:  openssl rand -base64 32
DIGITAL_PROFILE_SIGNED_URL_SECRET="CHANGE_ME_openssl_rand_base64_32"
DIGITAL_PROFILE_STORAGE_SIGNED_URL_TTL_SECONDS="900"

# ----------------------------------------------------------------------------
# Renderer microservice (compose service name `renderer`)
# ----------------------------------------------------------------------------
RENDERER_URL="http://renderer:8080"

# Server-side fallback template + pricing currency.
DIGITAL_PROFILE_REPORT_TEMPLATE_VERSION="report-template-v3"
DIGITAL_PROFILE_PRICE_CURRENCY="EUR"

# ----------------------------------------------------------------------------
# ORION-style SERP snapshot generator (Stage S1)
# ----------------------------------------------------------------------------
# Synthetic, key-free image built only from stored search_results. Safe in
# production (no live capture, no scraping). Requires fonts in the app image
# for SVG text (see Dockerfile: fonts-dejavu-core + fontconfig).
DIGITAL_PROFILE_SERP_SNAPSHOT_ENABLED="true"
DIGITAL_PROFILE_SERP_SNAPSHOT_FORMAT="png"
DIGITAL_PROFILE_SERP_SNAPSHOT_WIDTH="1600"
DIGITAL_PROFILE_SERP_SNAPSHOT_HEIGHT="950"
DIGITAL_PROFILE_SERP_SNAPSHOT_MAX_RESULTS_PER_ENGINE="7"
DIGITAL_PROFILE_SERP_SNAPSHOT_MAX_THEMES="5"
DIGITAL_PROFILE_SERP_SNAPSHOT_HIGHLIGHT_CLASSIFICATIONS="ADVERSE_MEDIA,SANCTIONS,PEP,NEGATIVE,HIGH_RISK"

# ----------------------------------------------------------------------------
# Real connectors (optional; off by default — only official/public APIs)
# ----------------------------------------------------------------------------
DIGITAL_PROFILE_REAL_CONNECTORS_ENABLED="false"
DIGITAL_PROFILE_WIKIPEDIA_ENABLED="true"
DIGITAL_PROFILE_WIKIPEDIA_LANGS="ru,en"

DIGITAL_PROFILE_GOOGLE_ENABLED="false"
DIGITAL_PROFILE_YANDEX_ENABLED="false"

GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""
YANDEX_SEARCH_API_KEY=""
YANDEX_SEARCH_FOLDER_ID=""
YANDEX_SEARCH_REGION=""

# Compliance databases — manual import only until official contracts exist.
LEXISNEXIS_API_KEY=""
DOWJONES_API_KEY=""
WORLDCHECK_API_KEY=""
