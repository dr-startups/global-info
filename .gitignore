.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
# Любая копия .env — это те же секреты. Правило добавлено после того, как
# `.env.backup-<дата>`, сделанная перед правкой конфигурации, попала под
# `git add -A`: ключи OpenAI и Yandex ушли в коммит, и пуш остановила защита
# GitHub. Наружу ничего не ушло, историю переписали — но полагаться на защиту
# как на последний рубеж нельзя.
.env.backup*
.env.bak*
# production env (real secrets — never commit). The *.example is safe to commit.
.env.production
.env.production.*
!.env.production.example

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db
/prisma/*.db-journal

# digital-profile private evidence/report storage (never commit)
/storage/
/private/
*.pptx
*.pdf

# Python (renderer)
__pycache__/
*.pyc

# local-only report-72 generated duplicates (not regression fixtures)
/baselines/report-72/artifacts/canonical-replay/
/baselines/report-72/artifacts/deck-sections/render-payload.json
# Страницы деки и контактный лист — такой же результат рендера, как соседние
# rendered-client.pptx/.pdf, которые уже отсечены правилами *.pptx / *.pdf выше.
# Коммитилась только PNG-половина: сверка числа страниц требует и PPTX, и PDF,
# поэтому она всё равно пропускалась, а ~6 МБ картинок лежали мёртвым грузом.
# Всё это создаёт `npm run orion:deck-sections-report72`.
/baselines/report-72/artifacts/deck-sections/pages-png/
/baselines/report-72/artifacts/deck-sections/contact-sheet.png

# Artifacts of the Playwright MCP browser session
.playwright-mcp/

# Локальные разрешения Claude Code: пути машины, идентификаторы реальных дел и
# SQL по ним — заметки конкретной машины, не общие для проекта.
/.claude/settings.local.json

# временные рабочие деревья — не репозиторий, а инструмент
/.claude/worktrees/
