{
  "name": "global-info",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "smoke:dp": "node scripts/smoke-digital-profile.mjs",
    "smoke:evidence": "node scripts/smoke-evidence.mjs",
    "smoke:report": "node scripts/smoke-report.mjs",
    "smoke:render": "node scripts/smoke-render.mjs",
    "smoke:agents": "node scripts/smoke-agents.mjs",
    "smoke:wikipedia": "node scripts/smoke-wikipedia.mjs",
    "smoke:search-providers": "tsx scripts/smoke-search-providers.ts",
    "smoke:search-providers:live": "node scripts/smoke-search-providers-live.mjs",
    "smoke:search-surfaces": "node scripts/smoke-search-surfaces.mjs",
    "smoke:risk-classifier": "node scripts/smoke-risk-classifier.mjs",
    "smoke:audit-summary": "node scripts/smoke-audit-summary.mjs",
    "smoke:report-template": "node scripts/smoke-report-template.mjs",
    "smoke:report-template-v2": "node scripts/smoke-report-template-v2.mjs",
    "smoke:report-template-v3": "node scripts/smoke-report-template-v3.mjs",
    "smoke:report-i18n": "node scripts/smoke-report-i18n.mjs",
    "smoke:i18n": "tsx scripts/smoke-i18n.ts",
    "smoke:suite": "tsx scripts/smoke-i18n.ts && node scripts/smoke-agents.mjs && node scripts/smoke-wikipedia.mjs && tsx scripts/smoke-search-providers.ts && node scripts/smoke-search-surfaces.mjs && node scripts/smoke-risk-classifier.mjs && node scripts/smoke-audit-summary.mjs && node scripts/smoke-render.mjs && node scripts/smoke-report-template.mjs && node scripts/smoke-report-template-v2.mjs && node scripts/smoke-report-template-v3.mjs && node scripts/smoke-report-i18n.mjs",
    "smoke:all": "npm run typecheck && npm run build && npm run smoke:suite",
    "smoke:all:with-renderer": "docker compose up -d --build renderer && npm run smoke:all"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
