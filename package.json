{
  "name": "global-info",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx scripts/worker.ts",
    "start:railway": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "ci:smokes": "npm run smoke:report-quality-summary && npm run smoke:golden-case && npm run smoke:unified-orion-collection && npm run smoke:gpt-call-queue && npm run smoke:render-http-retry && npm run smoke:client-text-contract && npm run smoke:orion-deck-sections && npm run smoke:orion-golden-render-imports",
    "smoke:renderer-text": "$(command -v python3 || command -v python) renderer/smoke_text_measurement.py",
    "smoke:orion-golden-render-imports": "$(command -v python3 || command -v python) scripts/smoke-orion-golden-render-imports.py",
    "ci": "npm run typecheck && npm test && npm run ci:smokes",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "smoke:unified-orion-collection": "tsx --test scripts/smoke-unified-orion-collection.ts",
    "smoke:render-http-retry": "tsx --test scripts/smoke-render-http-retry.ts",
    "smoke:gpt-call-queue": "tsx --test scripts/smoke-gpt-call-queue.ts",
    "fixture:deck-assets": "tsx scripts/export-deck-asset-fixture.ts",
    "fixture:deck-assets:rebuild": "tsx scripts/rebuild-deck-asset-fixture-from-baseline.ts",
    "smoke:orion-deck-sections": "tsx --test scripts/smoke-orion-deck-sections.ts",
    "smoke:report-quality-summary": "tsx --test scripts/smoke-report-quality-summary.ts",
    "smoke:client-text-contract": "tsx --test scripts/smoke-client-text-contract.ts",
    "golden-case": "tsx scripts/run-golden-case-report.ts",
    "smoke:golden-case": "tsx --test scripts/smoke-golden-case-report.ts",
    "orion:deck-sections-report72": "tsx scripts/run-orion-deck-sections-report72.ts",
    "arsenkin:db-readiness": "tsx scripts/generate-arsenkin-db-readiness.ts",
    "db:audit": "tsx scripts/db-schema-audit.ts",
    "db:deploy:raw": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "jszip": "^3.10.1",
    "next": "^15.1.4",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
