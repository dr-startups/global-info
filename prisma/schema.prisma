// Prisma schema for the Global Info platform.
//
// Digital Profile Audit module — evidence-first data model.
// All tables in this file belong to the digital-profile module and are namespaced
// with the `dp_` table prefix to keep the module isolated from future modules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum CaseStatus {
  DRAFT
  COLLECTING
  REVIEW
  REPORT_READY
  CLOSED
  ARCHIVED
}

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  OBTAINED
  REFUSED
}

enum LawfulBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  PUBLIC_INTEREST
  VITAL_INTEREST
}

enum AgentName {
  GOOGLE_SEARCH
  YANDEX_SEARCH
  WIKIPEDIA
  AI_PROFILE
  COMPLIANCE_DATABASE
  RISK_CLASSIFIER
  REPORT_SYNTHESIS
  SEARCH_SURFACES
}

// Stage H3 — additional search surfaces beyond organic results.
enum SearchSurfaceType {
  ORGANIC_RESULT
  SUGGESTION
  RELATED_QUERY
  IMAGE_RESULT
  VIDEO_RESULT
  KNOWLEDGE_BLOCK
  SERP_SCREENSHOT
  MANUAL_NOTE
}

enum SearchSurfaceSource {
  MOCK
  REAL_GOOGLE
  REAL_YANDEX
  REAL_WIKIPEDIA
  MANUAL_IMPORT
  SYNTHETIC_SNAPSHOT
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SearchEngine {
  GOOGLE
  YANDEX
  BING
  OTHER
}

enum QuerySource {
  MANUAL
  GENERATED
}

enum ResultClassification {
  UNCLASSIFIED
  RELEVANT
  IRRELEVANT
  ADVERSE_MEDIA
  SOCIAL_PROFILE
  CORPORATE
  LEGAL
  DUPLICATE
}

enum EvidenceType {
  URL
  SCREENSHOT
  IMPORTED_FILE
  DATABASE_RECORD
}

enum RiskSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum DatabaseProvider {
  LEXISNEXIS
  DOW_JONES
  WORLD_CHECK
  OTHER
}

enum ImportMethod {
  OFFICIAL_API
  MANUAL_IMPORT
}

// Stage C1 — compliance database hits (manual import + future official API).
enum ComplianceReviewStatus {
  PENDING
  MATCH_CONFIRMED
  FALSE_POSITIVE
  NEEDS_REVIEW
  DISMISSED
}

enum ComplianceHitSource {
  MANUAL
  OFFICIAL_API
  MOCK
}

enum ComplianceConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  FINAL
}

// Stage M1 — auth, roles and access control.
enum DpRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  REVIEWER
  CLIENT_VIEWER
}

enum DpAccessLevel {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}

// ----------------------------------------------------------------------------
// 1. cases
// ----------------------------------------------------------------------------

model Case {
  id            String        @id @default(cuid())
  caseNumber    String        @unique
  title         String
  status        CaseStatus    @default(DRAFT)
  // Compliance / legal
  lawfulBasis   LawfulBasis?
  consentStatus ConsentStatus @default(PENDING)
  // Audit scope
  targetRegions String[]      @default([])
  // Ownership / review
  createdBy     String
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?
  // Soft delete (evidence is never hard-deleted without an explicit admin action)
  deletedAt     DateTime?
  deletedBy     String?
  /**
   * Кейс создан смоком, а не оператором (шаг 13, B6). Списку оператора такие
   * строки не принадлежат: они не его работа. Признак хранится в записи, а не
   * выводится из префикса номера — номер это текст, который может совпасть.
   */
  isFixture     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subjects           Subject[]
  agentRuns          AgentRun[]
  searchQueries      SearchQuery[]
  searchResults      SearchResult[]
  searchSurfaceItems SearchSurfaceItem[]
  screenshots        Screenshot[]
  riskFindings       RiskFinding[]
  databaseProfiles   DatabaseProfile[]
  complianceScreeningRuns ComplianceScreeningRun[]
  wikipediaChecks    WikipediaCheck[]
  aiProfiles         AiProfile[]
  reportVersions     ReportVersion[]
  auditLogs        AuditLog[]
  caseAccess         DpCaseAccess[]
  orionReportRuns    OrionReportRun[]
  arsenkinStageRuns  OrionArsenkinStageRun[]
  serpCaptures       SerpCapture[]
  searchDocuments    SearchDocument[]
  serpObservations   SerpObservation[]
  serpSyntheticAssets SerpSyntheticAsset[]
  providerTasks      ProviderTask[]
  unifiedCollectionJobs UnifiedCollectionJobRecord[]
  workflowSteps      WorkflowStep[]

  @@index([status])
  @@index([deletedAt])
  @@index([isFixture])
  @@map("dp_cases")
}

// ----------------------------------------------------------------------------
// 2. subjects
// ----------------------------------------------------------------------------

model Subject {
  id          String    @id @default(cuid())
  caseId      String
  fullName    String
  aliases     String[]  @default([])
  dateOfBirth DateTime?
  nationality String?
  country     String?
  emails      String[]  @default([])
  phones      String[]  @default([])
  identifiers Json? // passport, tax id, etc. (structured, source-attributed)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("dp_subjects")
}

// ----------------------------------------------------------------------------
// 3. agent_runs
// ----------------------------------------------------------------------------

model AgentRun {
  id         String         @id @default(cuid())
  caseId     String
  agentName  AgentName
  status     AgentRunStatus @default(PENDING)
  input      Json?
  output     Json?
  error      String?
  itemsSaved Int            @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  triggeredBy String?
  createdAt  DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, agentName])
  @@map("dp_agent_runs")
}

// ----------------------------------------------------------------------------
// 4. search_queries
// ----------------------------------------------------------------------------

model SearchQuery {
  id        String       @id @default(cuid())
  caseId    String
  engine    SearchEngine
  queryText String
  source    QuerySource  @default(GENERATED)
  createdBy String?
  createdAt DateTime     @default(now())

  case    Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  results SearchResult[]

  @@index([caseId])
  @@map("dp_search_queries")
}

// ----------------------------------------------------------------------------
// 5. search_results
// ----------------------------------------------------------------------------

model SearchResult {
  id             String               @id @default(cuid())
  caseId         String
  queryId        String?
  engine         SearchEngine
  url            String
  normalizedUrl  String // used for de-duplication
  dedupHash      String // hash of normalizedUrl for fast dedup
  title          String?
  snippet        String?
  rank           Int?
  classification ResultClassification @default(UNCLASSIFIED)
  reviewStatus   ReviewStatus         @default(PENDING)
  // Provenance: e.g. "mock:GOOGLE_SEARCH", "real:GOOGLE". Distinguishes demo vs
  // real evidence without changing the engine semantics.
  source         String?
  // Raw, source-attributed provider payload (evidence-first). Never rendered raw.
  rawMetadata    Json?
  createdAt      DateTime             @default(now())

  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  query       SearchQuery? @relation(fields: [queryId], references: [id], onDelete: SetNull)
  screenshots Screenshot[]

  @@unique([caseId, dedupHash])
  @@index([caseId, classification])
  @@map("dp_search_results")
}

// ----------------------------------------------------------------------------
// 5b. search_surface_items (Stage H3 — suggestions, related, images, videos,
//     knowledge blocks, SERP screenshots, manual notes). Evidence-first: every
//     row records provider/source/query/region/language/capturedAt/rawMetadata.
// ----------------------------------------------------------------------------

model SearchSurfaceItem {
  id             String              @id @default(cuid())
  caseId         String
  type           SearchSurfaceType
  // Free-form provider label (GOOGLE/YANDEX/WIKIPEDIA/MANUAL), not the SearchEngine enum.
  provider       String?
  source         SearchSurfaceSource
  query          String?
  region         String?
  language       String?
  title          String?
  snippet        String?
  url            String?
  domain         String?
  imageUrl       String?
  thumbnailUrl   String?
  videoUrl       String?
  rank           Int?
  classification String?
  riskTheme      String?
  // Source-attributed raw payload (evidence-first). Never rendered raw.
  rawMetadata    Json?
  // Soft dedup within a case (hash of type|source|url|query|title).
  dedupHash      String
  capturedAt     DateTime            @default(now())
  demo           Boolean             @default(false)
  reviewStatus   ReviewStatus        @default(PENDING)
  // Evidence is never hard-deleted without an explicit admin action.
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, dedupHash])
  @@index([caseId])
  @@index([type])
  @@index([provider])
  @@index([source])
  @@index([caseId, type])
  @@index([caseId, provider])
  @@map("dp_search_surface_items")
}

// ----------------------------------------------------------------------------
// 6. screenshots
// ----------------------------------------------------------------------------

model Screenshot {
  id         String   @id @default(cuid())
  caseId     String
  resultId   String?
  // Private storage only — never a public URL. Signed URLs generated on demand.
  storageKey String
  mimeType   String   @default("image/png")
  sha256     String // integrity / tamper-evidence
  sizeBytes  Int?
  sourceUrl  String? // page the screenshot was captured from
  capturedAt DateTime @default(now())
  capturedBy String?
  // Evidence must not be deleted without an explicit admin action.
  deletedAt  DateTime?
  deletedBy  String?

  case   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  result SearchResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@map("dp_screenshots")
}

// ----------------------------------------------------------------------------
// 7. risk_findings
// ----------------------------------------------------------------------------

model RiskFinding {
  id           String       @id @default(cuid())
  caseId       String
  category     String
  severity     RiskSeverity @default(INFO)
  title        String
  summary      String?
  // Evidence references are mandatory for every finding.
  evidenceRefs Json         @default("[]") // EvidenceRef[]
  reviewStatus ReviewStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdBy    String? // agent name or user id
  // Stage I — Risk Classifier v1 structured fields (null for legacy/manual rows).
  signalType   String?
  riskTheme    String?
  confidence   Float?
  rationale    String?
  demo         Boolean      @default(false)
  // Idempotency key for the deterministic classifier (null for manual findings;
  // Postgres treats multiple NULLs as distinct, so manual rows are unaffected).
  dedupHash    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, dedupHash])
  @@index([caseId, severity])
  @@map("dp_risk_findings")
}

// ----------------------------------------------------------------------------
// 8. database_profiles (compliance hits)
// ----------------------------------------------------------------------------

model ComplianceScreeningRun {
  id           String           @id @default(cuid())
  caseId       String
  provider     DatabaseProvider
  status       String // SUCCESS | FAILED | NOT_CONFIGURED | DISABLED
  subjectName  String
  hitCount     Int              @default(0)
  errorCode    String?
  errorMessage String?
  runBy        String?
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?

  case Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  hits DatabaseProfile[]

  @@index([caseId, provider])
  @@map("dp_compliance_screening_runs")
}

model DatabaseProfile {
  id              String                  @id @default(cuid())
  caseId          String
  provider        DatabaseProvider
  importMethod    ImportMethod
  matchType       String? // legacy category label; e.g. PEP, sanction
  matchScore      Float?
  rawPayload      Json? // deprecated — prefer rawMetadataSafe
  evidenceRefs    Json                    @default("[]") // EvidenceRef[]
  importedBy      String?
  importedAt      DateTime                @default(now())
  // Stage C1 — normalized compliance hit fields
  screeningRunId  String?
  hitSource       ComplianceHitSource     @default(MANUAL)
  subjectName     String?
  matchedName     String?
  aliases         Json                    @default("[]")
  categories      Json                    @default("[]")
  riskTypes       Json                    @default("[]")
  countries       Json                    @default("[]")
  datesOfBirth    Json                    @default("[]")
  confidence      ComplianceConfidence?
  profileId       String?
  profileUrl      String?
  summary         String?
  reviewStatus    ComplianceReviewStatus  @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  riskFindingId   String?
  rawMetadataSafe Json?

  case           Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  screeningRun   ComplianceScreeningRun? @relation(fields: [screeningRunId], references: [id], onDelete: SetNull)

  @@index([caseId, provider])
  @@index([caseId, reviewStatus])
  @@map("dp_database_profiles")
}

// ----------------------------------------------------------------------------
// 9. wikipedia_checks
// ----------------------------------------------------------------------------

model WikipediaCheck {
  id          String   @id @default(cuid())
  caseId      String
  exists      Boolean  @default(false)
  url         String?
  language    String?  @default("en")
  pageTitle   String?
  snapshot    Json? // captured summary/metadata (read-only; never auto-published)
  lastChecked DateTime @default(now())
  checkedBy   String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("dp_wikipedia_checks")
}

// ----------------------------------------------------------------------------
// 10. ai_profiles
// ----------------------------------------------------------------------------

model AiProfile {
  id              String   @id @default(cuid())
  caseId          String
  model           String
  summary         String?
  classifications Json? // structured AI output derived ONLY from evidence
  // LLM is not a source of fact — outputs must reference underlying evidence.
  evidenceRefs    Json     @default("[]") // EvidenceRef[]
  disclaimer      String   @default("AI-generated summary based on collected evidence. Not a source of fact.")
  createdAt       DateTime @default(now())
  createdBy       String?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("dp_ai_profiles")
}

// ----------------------------------------------------------------------------
// 11. report_versions
// ----------------------------------------------------------------------------

model ReportVersion {
  id         String       @id @default(cuid())
  caseId     String
  version    Int
  status     ReportStatus @default(DRAFT)
  reportJson Json // ReportJson — single source for the renderer
  // Rendered artifacts live in PRIVATE storage; served only via signed URLs.
  pptxUrl        String? // legacy/optional snapshot URL (unused; see storage keys)
  pdfUrl         String? // legacy/optional snapshot URL (unused; see storage keys)
  pptxStorageKey String?
  pdfStorageKey  String?
  renderedAt     DateTime?
  // Stage K1 — which template rendered this version + non-fatal renderer warnings.
  templateVersion String?
  renderWarnings  Json?
  // Watermark "Draft" until final review is complete.
  watermark  String?      @default("DRAFT")
  createdBy  String?
  createdAt  DateTime     @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, version])
  @@index([caseId])
  @@map("dp_report_versions")
}

// ----------------------------------------------------------------------------
// 11b. Unified ORION collection job store (REMEDIATION §9.4)
// ----------------------------------------------------------------------------

/// Durable unified-collection job row (domain type remains UnifiedCollectionJob).
model UnifiedCollectionJobRecord {
  id                  String    @id @default(cuid())
  caseId              String    @unique
  jobId               String    @unique
  unifiedJobId        String
  stage               String
  status              String
  progress            Float     @default(0)
  versionNum          Int       @default(0)
  leaseOwnerId        String?
  leaseUntil          DateTime?
  requestedBy         String
  arsenkinMode        String?
  baseReportRunId     String?
  arsenkinReportRunId String?
  compositeDatasetId  String?
  cancelRequested     Boolean   @default(false)
  resumeCheckpoint    String?
  nextPollAt          DateTime?
  pollAttempt         Int?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  /// Full UnifiedCollectionJob JSON (domain type) minus fields that are columns
  payloadJson         Json
  /// logicalName → storage key (db) or absolute path (file bootstrap)
  artifactKeys        Json      @default("{}")
  reportLinkKeys      Json      @default("{}")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status, stage])
  @@index([leaseUntil])
  @@map("dp_unified_collection_jobs")
}

/// Единица долговечной работы (шаг 12). Строка этой таблицы — и запись о
/// прогрессе, и элемент очереди: воркер забирает готовые к исполнению шаги
/// через FOR UPDATE SKIP LOCKED. Отдельного брокера нет намеренно — источник
/// правды один, поэтому второй правды о том, что делать дальше, не возникает.
model WorkflowStep {
  id            String    @id @default(cuid())
  caseId        String
  /// unifiedJobId прогона, которому принадлежит шаг
  jobId         String
  /// Имя шага из реестра конвейера (BASE_COLLECTION, ARSENKIN_ENRICHMENT, …)
  name          String
  /// Порядок в конвейере — для вывода стадии джобы и выбора следующего шага
  position      Int
  /// PENDING | RUNNING | WAITING | DONE | FAILED | SKIPPED
  state         String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(40)
  /// Когда шаг снова готов к исполнению; null — не запланирован
  nextRunAt     DateTime?
  leaseOwner    String?
  leaseUntil    DateTime?
  /// Ключ идемпотентности платного эффекта
  inputHash     String?
  /// Указатель на артефакт результата
  outputRef     String?
  lastError     String?
  lastErrorCode String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@index([state, nextRunAt])
  @@index([caseId, position])
  @@map("dp_workflow_steps")
}

// ----------------------------------------------------------------------------
// 11c. ORION report runs
// ----------------------------------------------------------------------------

model OrionReportRun {
  id          String   @id @default(cuid())
  caseId      String
  reportVersionId String?
  mode        String
  storeMode   String   @default("file")
  status      String
  internalOnly Boolean @default(true)
  metadataJson Json?
  warningsJson Json?
  errorsJson  Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  serpCaptures       SerpCapture[]
  serpObservations   SerpObservation[]
  serpSyntheticAssets SerpSyntheticAsset[]
  providerTasks      ProviderTask[]
  surfaceCollectionCoverage SurfaceCollectionCoverage[]
  arsenkinStageRuns OrionArsenkinStageRun[]

  @@index([caseId])
  @@index([reportVersionId])
  @@index([status])
  @@index([createdAt])
  @@map("dp_orion_report_runs")
}

/// Run-scoped Arsenkin live stage ledger (P0.5). One row per (reportRunId, stage).
model OrionArsenkinStageRun {
  id                   String    @id @default(cuid())
  reportRunId          String
  caseId               String
  stage                String
  status               String
  planDigest           String?
  leaseOwnerId         String?
  maxNewTasks          Int?
  maxEstimatedLimits   Int?
  estimatedLimitsTotal Int?
  plannedNewTasks      Int?
  errorJson            Json?
  metadataJson         Json?
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  reportRun OrionReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([reportRunId, stage], map: "dp_orion_arsenkin_stage_unique")
  @@index([reportRunId, status])
  @@index([caseId])
  @@map("dp_orion_arsenkin_stage_runs")
}

model ProviderTask {
  id             String    @id @default(cuid())
  caseId         String?
  reportRunId    String?
  provider       String
  toolName       String
  externalTaskId String?
  requestHash    String
  state          String
  attempts       Int       @default(0)
  nextPollAt     DateTime?
  errorCode      String?
  limitsSpent    Int?
  lockedBy       String?
  lockedAt       DateTime?
  leaseUntil     DateTime?
  submittedAt    DateTime?
  latencyMs      Int?
  limitsBefore   Int?
  limitsAfter    Int?
  requestJson    Json
  responseJson   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  case      Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  reportRun OrionReportRun? @relation(fields: [reportRunId], references: [id], onDelete: SetNull)

  serpObservations SerpObservation[]
  surfaceCollectionCoverage SurfaceCollectionCoverage[]

  @@unique([reportRunId, provider, requestHash])
  @@index([state, nextPollAt])
  @@index([reportRunId])
  @@index([caseId])
  @@index([externalTaskId])
  @@map("dp_provider_tasks")
}

// ----------------------------------------------------------------------------
// 11b. Run-scoped SERP observations (provider-first; no URL dedupe across queries)
// ----------------------------------------------------------------------------

model SearchDocument {
  id          String   @id @default(cuid())
  caseId      String
  url         String
  canonicalUrl String?
  domain      String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case         Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  observations SerpObservation[]

  @@unique([caseId, url])
  @@index([caseId])
  @@index([domain])
  @@map("dp_search_documents")
}

model SerpObservation {
  id               String   @id @default(cuid())
  caseId           String
  auditRunId       String
  queryId          String
  queryText        String
  parentQueryId    String?
  provider         String
  engine           String
  device           String   @default("DESKTOP")
  surface          String   @default("organic")
  region           String
  language         String
  rank             Int
  url              String
  title            String?
  snippet          String?
  domain           String?
  searchDocumentId String?
  providerTaskId   String?
  providerStatus   String   @default("OK")
  rawPayloadJson   Json?
  capturedAt       DateTime
  createdAt        DateTime @default(now())

  case           Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  auditRun       OrionReportRun       @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  searchDocument SearchDocument?      @relation(fields: [searchDocumentId], references: [id], onDelete: SetNull)
  providerTask   ProviderTask?        @relation(fields: [providerTaskId], references: [id], onDelete: SetNull)
  syntheticLinks SerpSyntheticAssetObservation[]

  @@index([caseId])
  @@index([auditRunId])
  @@index([queryId])
  @@index([providerTaskId])
  @@index([provider, engine, surface])
  @@index([url])
  @@index([capturedAt])
  @@unique([auditRunId, provider, engine, region, language, device, surface, queryId, rank, url], map: "serp_obs_run_unique")
  @@map("dp_serp_observations")
}

model SurfaceCollectionCoverage {
  id             String   @id @default(cuid())
  reportRunId    String
  provider       String
  tool           String
  providerTaskId String?
  queryId        String
  queryText      String
  engine         String
  region         String
  language       String
  device         String   @default("DESKTOP")
  surface        String
  status         String
  resultCount    Int
  errorCode      String?
  capturedAt     DateTime
  createdAt      DateTime @default(now())

  reportRun     OrionReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  providerTask  ProviderTask?  @relation(fields: [providerTaskId], references: [id], onDelete: SetNull)

  @@unique([reportRunId, provider, tool, queryId, surface, engine, region, language, device], map: "dp_surface_coverage_biz_unique")
  @@index([reportRunId])
  @@index([reportRunId, surface])
  @@index([providerTaskId])
  @@map("dp_surface_collection_coverage")
}

model ProviderAccountLimiter {
  id              String   @id
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  inFlight        Int      @default(0)
  maxConcurrent   Int
  maxRpm          Int
  updatedAt       DateTime @updatedAt

  @@map("dp_provider_account_limiter")
}

/// Per-request lease for Arsenkin account concurrency + sliding RPM budget.
model ProviderAccountRequestLease {
  id         String    @id @default(cuid())
  limiterId  String
  ownerId    String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  releasedAt DateTime?

  @@index([limiterId, createdAt])
  @@index([limiterId, expiresAt])
  @@map("dp_provider_account_request_leases")
}

model SerpSyntheticAsset {
  id            String   @id @default(cuid())
  caseId        String
  auditRunId    String
  queryId       String
  provider      String
  engine        String
  surface       String   @default("organic")
  region        String
  language      String
  storageKey    String
  sha256        String
  mimeType      String   @default("image/png")
  width         Int?
  height        Int?
  caption       String
  status        String   @default("READY")
  createdAt     DateTime @default(now())

  case         Case                              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  auditRun     OrionReportRun                    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  observations SerpSyntheticAssetObservation[]

  @@index([caseId])
  @@index([auditRunId])
  @@index([queryId])
  @@index([sha256])
  @@map("dp_serp_synthetic_assets")
}

model SerpSyntheticAssetObservation {
  id                String @id @default(cuid())
  syntheticAssetId  String
  observationId     String
  rank              Int

  syntheticAsset SerpSyntheticAsset @relation(fields: [syntheticAssetId], references: [id], onDelete: Cascade)
  observation    SerpObservation    @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([syntheticAssetId, observationId])
  @@index([observationId])
  @@map("dp_serp_synthetic_asset_observations")
}

// ----------------------------------------------------------------------------
// 11c. LIVE SERP browser captures (Stage S2)
// ----------------------------------------------------------------------------

model SerpCapture {
  id             String    @id @default(cuid())
  caseId         String
  reportRunId    String
  query          String
  queryHash      String
  engine         String
  region         String
  locale         String
  device         String    @default("DESKTOP")
  captureStatus  String
  geoStatus      String    @default("UNKNOWN")
  connectionMode String    @default("DIRECT")
  storageKey     String?
  sha256         String?
  sourceUrl      String?
  mimeType       String?
  sizeBytes      Int?
  capturedAt     DateTime?
  capturedBy     String?
  metadataJson   Json?
  errorJson      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reportRun OrionReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([reportRunId, queryHash, engine, region, device, captureStatus])
  @@map("dp_serp_captures")
}


// ----------------------------------------------------------------------------
// 12. audit_logs
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  caseId     String?
  actorId    String
  action     String // e.g. CASE_CREATED, FINDING_REVIEWED, EVIDENCE_DELETED
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actorId])
  @@map("dp_audit_logs")
}

// ----------------------------------------------------------------------------
// 13. users (Stage M1 — auth + roles)
// ----------------------------------------------------------------------------

model DpUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         DpRole   @default(ANALYST)
  // scrypt password hash ("scrypt$N$r$p$salt$hash"). Never store plain passwords.
  passwordHash String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  caseAccess DpCaseAccess[]

  @@index([role])
  @@map("dp_users")
}

// ----------------------------------------------------------------------------
// 14. case access grants (Stage M1)
//     Per-case access for users (primarily CLIENT_VIEWER). Staff roles
//     (SUPER_ADMIN/ADMIN/ANALYST/REVIEWER) get global access via their role; a
//     grant row narrows or explicitly assigns a specific case to a user.
// ----------------------------------------------------------------------------

model DpCaseAccess {
  id          String        @id @default(cuid())
  caseId      String
  userId      String
  accessLevel DpAccessLevel @default(VIEWER)
  createdBy   String?
  createdAt   DateTime      @default(now())

  case Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user DpUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@index([caseId])
  @@map("dp_case_access")
}
